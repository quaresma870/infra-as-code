#!/usr/bin/env bash
# Managed by Ansible — cleans up old backups beyond retention policy.
# Keeps {{ backup_keep_daily }} daily backups and {{ backup_keep_weekly }} weekly (Sunday) backups.

set -euo pipefail

BACKUP_DIR="{{ backup_dest_dir }}"
KEEP_DAILY={{ backup_keep_daily }}
KEEP_WEEKLY={{ backup_keep_weekly }}

cd "$BACKUP_DIR" || exit 0

# List backup directories sorted newest first (format: YYYYMMDD_HHMMSS)
mapfile -t ALL_BACKUPS < <(find . -maxdepth 1 -type d -name '20*' | sed 's|^\./||' | sort -r)

# Identify weekly backups (Sunday) to always keep
WEEKLY_BACKUPS=()
for b in "${ALL_BACKUPS[@]}"; do
  date_part="${b:0:8}"
  if date -d "$date_part" +%u 2>/dev/null | grep -q '^7$'; then
    WEEKLY_BACKUPS+=("$b")
  fi
done

KEEP_LIST=()
KEEP_LIST+=("${ALL_BACKUPS[@]:0:$KEEP_DAILY}")
KEEP_LIST+=("${WEEKLY_BACKUPS[@]:0:$KEEP_WEEKLY}")

for b in "${ALL_BACKUPS[@]}"; do
  keep=false
  for k in "${KEEP_LIST[@]}"; do
    [ "$b" = "$k" ] && keep=true && break
  done
  if ! $keep; then
    echo "Removing old backup: $b"
    rm -rf "$b"
  fi
done

echo "Cleanup complete. Kept: ${#KEEP_LIST[@]} backups."
